{
  "display": {
    "separator": " "
  },
  "logo": {
    "type": "small"
  },
  "modules": [
    {
      "format": "{2}",
      "key": "host  ",
      "type": "host"
    },
    {
      "format": "{2}",
      "key": "os    ",
      "type": "os"
    },
    {
      "format": "{2}",
      "key": "kernel",
      "type": "kernel"
    },
    {
      "format": "{all}",
      "key": "pkgs  ",
      "type": "packages"
    },
    {
      "format": "{1}",
      "key": "shell ",
      "type": "shell"
    },
    {
      "format": "{1}",
      "key": "term  ",
      "type": "terminal"
    },
    {
      "format": "{1}",
      "key": "wm    ",
      "type": "wm"
    },
    {
      "key": "age   ",
      "text": "echo $(( ( $(date +%s) - $(stat -c %W /) ) / 86400 )) days",
      "type": "command"
    },
    {
      "format": "{1}d {2}h {3}m",
      "key": "uptime",
      "type": "uptime"
    }
  ]
}
